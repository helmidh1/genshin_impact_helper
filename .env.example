# ==============================================================================
# Teyvat Strategist — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local to configure optional server-side integrations:
#   cp .env.example .env.local
#
# All features in Teyvat Strategist are local-first and function without any
# API keys or credentials.
# ==============================================================================

# Optional: Google Gemini API Key for live AI Combat & Rotation Coaching.
# Powered by Gemini 3.8 Flash via the @google/genai Interactions API.
# If unset or unreachable, Teyvat Strategist automatically runs on pure,
# deterministic domain heuristics without error or degradation.
GEMINI_API_KEY=

# Optional: HoYoLAB Server-side Synchronization
# Allows pre-configuring HoYoLAB credentials on the server rather than entering
# them via the browser UI.
# HOYOLAB_LTUID_V2=
# HOYOLAB_LTOKEN_V2=
